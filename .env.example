# onchain_agent_guard on devnet (onchain/deploy-devnet.sh prints the address of a new deploy)
GUARD_PROGRAM_ID=BL6Fjh4pADgjvZwaueeAcc7rYddFrdMNWnqK73x78ZSs
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
# Pays the agents' step fees. On devnet the same wallet is the owner (register, kill, resume); the server signs kill and
# resume with it, because the page has no wallet yet.
FEE_PAYER_KEYPAIR=.devnet/payer.json
OWNER_KEYPAIR=.devnet/payer.json
