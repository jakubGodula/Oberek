# onchain_agent_guard on devnet (onchain/deploy-devnet.sh prints the address of a new deploy)
GUARD_PROGRAM_ID=BL6Fjh4pADgjvZwaueeAcc7rYddFrdMNWnqK73x78ZSs
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
# Pays the agents' step fees. On devnet the same wallet is the owner (register, kill, resume); the server signs kill and
# resume with it, because the page has no wallet yet.
FEE_PAYER_KEYPAIR=.devnet/payer.json
OWNER_KEYPAIR=.devnet/payer.json
# The owner's ML-KEM-768 key pair (created by setup or `bun scripts/fleet.ts owner-key`): new agents' decision logs are
# sealed to its public key, and the audit opens them with its secret key.
OWNER_MLKEM_FILE=.devnet/owner-mlkem.json
# The owner's ML-DSA-44 key, which activates every agent (written by bun scripts/agent.ts register-owner). No wallet
# signs ML-DSA yet, so it lives on the server next to the owner's wallet.
OWNER_MLDSA_FILE=.devnet/owner-mldsa.json
# Agents whose decisions go on-chain in batches (comma-separated ids, e.g. tick-01): the server answers 202, buffers
# them and records each buffer with one record_batch under a Merkle root. Empty: every decision is its own step.
BATCHED_AGENT_IDS=
# BATCH_FLUSH_MS=10000
# BATCH_MAX_DECISIONS=16

# The owner's Telegram bot (bun bot/telegram); the server reads none of these. Create the bot with @BotFather, put its
# token here, then send /start to the bot: it answers with your chat id.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_CHAT_ID=
# The Oberek server the bot calls (not Telegram's API); default http://localhost:5173.
# TELEGRAM_API_URL=http://localhost:5173
