# The guard the server uses for its fleet agents: fake (local files: accounts and fleet in .fake-chain/) or devnet
# (onchain_agent_guard; fleet in .devnet/fleet/, needs everything below). Default fake. Set it here, or put
# CHAIN=devnet in .env.devnet and run `bun run dev -- --mode devnet`; a shell variable does not reach the dev server.
# Run one dev server per checkout: SvelteKit writes these values into the shared .svelte-kit/, so a second server with
# another CHAIN switches the first one too.
CHAIN=fake
# onchain_agent_guard on devnet: the address printed by onchain/deploy-devnet.sh
GUARD_PROGRAM_ID=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
# Pays the agent's step fees. On devnet the same wallet is the owner (register, kill, resume); with CHAIN=devnet the
# server signs kill and resume with it, because the page has no wallet yet.
FEE_PAYER_KEYPAIR=spikes/falcon-noble-compat/.devnet/payer.json
OWNER_KEYPAIR=spikes/falcon-noble-compat/.devnet/payer.json
AGENT_TICK_MS=30000
# Holds the agent's ML-DSA-44 secret key; gitignored.
AGENT_FILE=.devnet/agent.json
AGENT_DECISION_LOG=.devnet/decisions.jsonl
